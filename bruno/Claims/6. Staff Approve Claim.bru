meta {
  name: 6. Staff Approve Claim
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/claims/{{claimId}}/decision
  body: json
  auth: none
}

headers {
  x-user-id: {{staffId}}
}

body:json {
  {
    "action": "APPROVE",
    "staffVerifiedEvidence": true
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("claim is APPROVED", function() {
    expect(res.body.data.status).to.equal("APPROVED");
  });
}

docs {
  staffVerifiedEvidence only matters when the match is WEAK_MATCH — the
  decideClaim rule requires it in that case or the request 400s. Safe to
  always send true.
}
