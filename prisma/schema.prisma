generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  STUDENT
  STAFF
  ADMIN
}

enum ReportType {
  LOST
  FOUND
}

enum ReportStatus {
  OPEN
  MATCHED
  CLAIM_IN_PROGRESS
  RESOLVED
  DONATED
  DISPOSED
  ARCHIVED
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
  INFO_REQUESTED
  COMPLETED
  MORE_INFORMATION_REQUIRED
}

enum AuditAction {
  REPORT_CREATED
  CLAIM_SUBMITTED
  CLAIM_DECIDED
  HANDOVER_COMPLETED
}

enum MatchDecisionType {
  CONFIRMED
  DISMISSED
}

enum EvidenceType {
  PHOTO
  RECEIPT
  SERIAL_NUMBER
  IDENTIFYING_MARKS
}

enum NotificationType {
  MATCH_CONFIRMED
  CLAIM_APPROVED
  CLAIM_REJECTED
  CLAIM_INFO_REQUESTED
  HANDOVER_READY
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  name      RoleName @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  universityId String?  @unique
  displayName  String
  microsoftOid String?  @unique
  passwordHash String?
  isActive     Boolean  @default(true)
  tokenVersion Int? @default(0)
  username String? @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roleId String @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  itemReports    ItemReport[]
  claims         Claim[]         @relation("ClaimantUser")
  decisions      Claim[]         @relation("DecidedByUser")
  handovers      Claim[]         @relation("HandoverByUser")
  auditLogs      AuditLog[]
  matchDecisions MatchDecision[]
  notifications  Notification[]

  @@index([roleId])
}

model ItemCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  itemReports ItemReport[]
}

model ItemReport {
  id          String       @id @default(uuid()) @db.Uuid
  title       String
  description String       @db.Text
  reportType  ReportType
  status      ReportStatus @default(OPEN)
  location    String
  occurredAt  DateTime
  reportedAt  DateTime     @default(now())
  color       String?
  brand       String?
  photoUrl    String?
  isPublic    Boolean      @default(true)
  embedding Json?
  embeddingError String?
  embeddingFingerprint String?
  embeddingModel String?
  embeddingStatus EmbeddingStatus? @default(PENDING)
  embeddingUpdatedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  createdById String @db.Uuid
  categoryId  String @db.Uuid

  createdBy User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  category  ItemCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  claimsAsLostReport  Claim[] @relation("LostReport")
  claimsAsFoundReport Claim[] @relation("FoundReport")

  matchDecisionsAsLostReport  MatchDecision[] @relation("MatchDecisionLostReport")
  matchDecisionsAsFoundReport MatchDecision[] @relation("MatchDecisionFoundReport")
  notifications               Notification[]

  @@index([createdById])
  @@index([categoryId])
  @@index([reportType, status])
  @@index([location])
  @@index([occurredAt])
}

model MatchDecision {
  id        String            @id @default(uuid()) @db.Uuid
  decision  MatchDecisionType
  createdAt DateTime          @default(now())

  lostReportId  String @db.Uuid
  foundReportId String @db.Uuid
  decidedById   String @db.Uuid

  lostReport  ItemReport @relation("MatchDecisionLostReport", fields: [lostReportId], references: [id], onDelete: Cascade)
  foundReport ItemReport @relation("MatchDecisionFoundReport", fields: [foundReportId], references: [id], onDelete: Cascade)
  decidedBy   User       @relation(fields: [decidedById], references: [id], onDelete: Restrict)

  @@unique([lostReportId, foundReportId])
  @@index([lostReportId])
  @@index([foundReportId])
}

model Claim {
  id                       String      @id @default(uuid()) @db.Uuid
  claimNumber              Int         @unique @default(autoincrement())
  status                   ClaimStatus @default(PENDING)
  matchScore               Int
  ownershipScore           Int?
  evidenceDescription      String?     @db.Text
  staffVerifiedEvidence    Boolean     @default(false)
  decisionReason           String?     @db.Text
  handoverVerifiedIdentity Boolean     @default(false)
  handoverConfirmedAt      DateTime?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt
  decidedAt                DateTime?

  lostReportId          String  @db.Uuid
  foundReportId         String  @db.Uuid
  claimantId            String  @db.Uuid
  decidedById           String? @db.Uuid
  handoverConfirmedById String? @db.Uuid

  lostReport          ItemReport @relation("LostReport", fields: [lostReportId], references: [id], onDelete: Restrict)
  foundReport         ItemReport @relation("FoundReport", fields: [foundReportId], references: [id], onDelete: Restrict)
  claimant            User       @relation("ClaimantUser", fields: [claimantId], references: [id], onDelete: Restrict)
  decidedBy           User?      @relation("DecidedByUser", fields: [decidedById], references: [id], onDelete: SetNull)
  handoverConfirmedBy User?      @relation("HandoverByUser", fields: [handoverConfirmedById], references: [id], onDelete: SetNull)

  auditLogs     AuditLog[]
  notifications Notification[]
  evidence      Evidence[]

  @@index([lostReportId])
  @@index([foundReportId])
  @@index([claimantId])
  @@index([status])
}

model Evidence {
  id           String       @id @default(uuid()) @db.Uuid
  evidenceType EvidenceType
  description  String       @db.Text
  url          String?
  createdAt    DateTime     @default(now())

  claimId String @db.Uuid
  claim   Claim  @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  type      NotificationType
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  userId   String  @db.Uuid
  reportId String? @db.Uuid
  claimId  String? @db.Uuid

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  report ItemReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  claim  Claim?      @relation(fields: [claimId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([claimId])
}

model AuditLog {
  id        String      @id @default(uuid()) @db.Uuid
  action    String
  metadata  Json?
  createdAt DateTime    @default(now())
  entityType String?
  entityId String? @db.Uuid
  details Json?
  actorUserId String? @db.Uuid

  actorId String? @db.Uuid
  claimId String? @db.Uuid

  actor User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)
  claim Claim? @relation(fields: [claimId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([claimId])
  @@index([action])
}

enum EmbeddingStatus {
  PENDING
  READY
  FAILED
}

enum MatchConfidence {
  HIGH
  POSSIBLE
}

enum MatchStatus {
  SUGGESTED
  CONFIRMED
  REJECTED
  CLAIMED
  RESOLVED
}

model ClaimRequest {
  id                                       String          @id @db.Uuid
  status                                   ClaimStatus     @default(PENDING)
  identifyingDetails                       String
  reviewNote                               String?
  createdAt                                DateTime        @default(now())
  updatedAt                                DateTime
  claimantUserId                           String          @db.Uuid
  foundReportId                            String          @db.Uuid
  reviewedByUserId                         String?         @db.Uuid
}

model ClaimEvidence {
  id             String       @id @db.Uuid
  evidenceType   String
  textValue      String?
  objectKey      String?      @unique
  mimeType       String?
  fileSize       Int?
  createdAt      DateTime     @default(now())
  claimRequestId String       @db.Uuid
}

model ItemImage {
  id         String     @id @db.Uuid
  objectKey  String     @unique
  mimeType   String
  fileSize   Int
  createdAt  DateTime   @default(now())
  reportId   String     @db.Uuid
}

model MatchSuggestion {
  id                                                   String          @id @db.Uuid
  matchSource                                          String          @default("AI_ASSISTED")
  createdAt                                            DateTime        @default(now())
  lostReportId                                         String          @db.Uuid
  foundReportId                                        String          @db.Uuid
  categoryScore                                        Float
  colorScore                                           Float
  confidence                                           MatchConfidence
  dateScore                                            Float
  descriptionSimilarityScore                           Float
  locationScore                                        Float
  reasons                                              Json
  reviewedAt                                           DateTime?
  reviewerId                                           String?         @db.Uuid
  status                                               MatchStatus     @default(SUGGESTED)
  totalScore                                           Float
  updatedAt                                            DateTime
}

model PartnerClient {
  id                String              @id @db.Uuid
  name              String              @unique
  description       String?
  baseUrl           String
  apiKeyIdentifier  String              @unique
  apiKeyHash        String
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
}

model PartnerSyncEvent {
  id               String        @id @db.Uuid
  operation        String
  receivedCount    Int
  createdCount     Int
  updatedCount     Int
  deactivatedCount Int
  createdAt        DateTime      @default(now())
  partnerId        String        @db.Uuid
}

model PartnerSyncedItem {
  id              String        @id @db.Uuid
  externalId      String
  title           String
  category        String?
  location        String
  occurredAt      DateTime
  status          String        @default("OPEN")
  sourceUrl       String?
  remoteUpdatedAt DateTime?
  lastSyncedAt    DateTime      @default(now())
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime
  partnerId       String        @db.Uuid
}
