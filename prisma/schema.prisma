generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  STUDENT
  STAFF
  ADMIN
}

enum ReportType {
  LOST
  FOUND
}

enum ReportStatus {
  OPEN
  MATCHED
  CLAIM_IN_PROGRESS
  RESOLVED
  DONATED
  DISPOSED
  ARCHIVED
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
  INFO_REQUESTED
  COMPLETED
}

enum AuditAction {
  REPORT_CREATED
  CLAIM_SUBMITTED
  CLAIM_DECIDED
  HANDOVER_COMPLETED
}

enum MatchDecisionType {
  CONFIRMED
  DISMISSED
}

enum NotificationType {
  MATCH_CONFIRMED
  CLAIM_APPROVED
  CLAIM_REJECTED
  CLAIM_INFO_REQUESTED
  HANDOVER_READY
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  name      RoleName @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  universityId String?  @unique
  displayName  String
  microsoftOid String?  @unique
  passwordHash String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roleId String @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  itemReports    ItemReport[]
  claims         Claim[]         @relation("ClaimantUser")
  decisions      Claim[]         @relation("DecidedByUser")
  handovers      Claim[]         @relation("HandoverByUser")
  auditLogs      AuditLog[]
  matchDecisions MatchDecision[]
  notifications  Notification[]

  @@index([roleId])
}

model ItemCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  itemReports ItemReport[]
}

model ItemReport {
  id          String       @id @default(uuid()) @db.Uuid
  title       String
  description String       @db.Text
  reportType  ReportType
  status      ReportStatus @default(OPEN)
  location    String
  occurredAt  DateTime
  reportedAt  DateTime     @default(now())
  color       String?
  brand       String?
  photoUrl    String?
  isPublic    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  createdById String @db.Uuid
  categoryId  String @db.Uuid

  createdBy User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  category  ItemCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  claimsAsLostReport  Claim[] @relation("LostReport")
  claimsAsFoundReport Claim[] @relation("FoundReport")

  matchDecisionsAsLostReport  MatchDecision[] @relation("MatchDecisionLostReport")
  matchDecisionsAsFoundReport MatchDecision[] @relation("MatchDecisionFoundReport")
  notifications               Notification[]

  @@index([createdById])
  @@index([categoryId])
  @@index([reportType, status])
  @@index([location])
  @@index([occurredAt])
}

model MatchDecision {
  id        String            @id @default(uuid()) @db.Uuid
  decision  MatchDecisionType
  createdAt DateTime          @default(now())

  lostReportId  String @db.Uuid
  foundReportId String @db.Uuid
  decidedById   String @db.Uuid

  lostReport  ItemReport @relation("MatchDecisionLostReport", fields: [lostReportId], references: [id], onDelete: Cascade)
  foundReport ItemReport @relation("MatchDecisionFoundReport", fields: [foundReportId], references: [id], onDelete: Cascade)
  decidedBy   User       @relation(fields: [decidedById], references: [id], onDelete: Restrict)

  @@unique([lostReportId, foundReportId])
  @@index([lostReportId])
  @@index([foundReportId])
}

model Claim {
  id                       String      @id @default(uuid()) @db.Uuid
  claimNumber              Int         @unique @default(autoincrement())
  status                   ClaimStatus @default(PENDING)
  matchScore               Int
  evidenceDescription      String      @db.Text
  staffVerifiedEvidence    Boolean     @default(false)
  decisionReason           String?     @db.Text
  handoverVerifiedIdentity Boolean     @default(false)
  handoverConfirmedAt      DateTime?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt
  decidedAt                DateTime?

  lostReportId          String  @db.Uuid
  foundReportId         String  @db.Uuid
  claimantId            String  @db.Uuid
  decidedById           String? @db.Uuid
  handoverConfirmedById String? @db.Uuid

  lostReport          ItemReport @relation("LostReport", fields: [lostReportId], references: [id], onDelete: Restrict)
  foundReport         ItemReport @relation("FoundReport", fields: [foundReportId], references: [id], onDelete: Restrict)
  claimant            User       @relation("ClaimantUser", fields: [claimantId], references: [id], onDelete: Restrict)
  decidedBy           User?      @relation("DecidedByUser", fields: [decidedById], references: [id], onDelete: SetNull)
  handoverConfirmedBy User?      @relation("HandoverByUser", fields: [handoverConfirmedById], references: [id], onDelete: SetNull)

  auditLogs     AuditLog[]
  notifications Notification[]

  @@index([lostReportId])
  @@index([foundReportId])
  @@index([claimantId])
  @@index([status])
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  type      NotificationType
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  userId   String  @db.Uuid
  reportId String? @db.Uuid
  claimId  String? @db.Uuid

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  report ItemReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  claim  Claim?      @relation(fields: [claimId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([claimId])
}

model AuditLog {
  id        String      @id @default(uuid()) @db.Uuid
  action    AuditAction
  metadata  Json?
  createdAt DateTime    @default(now())

  actorId String? @db.Uuid
  claimId String? @db.Uuid

  actor User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)
  claim Claim? @relation(fields: [claimId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([claimId])
  @@index([action])
}
