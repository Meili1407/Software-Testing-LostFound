digraph scoreDescription {
  rankdir=TB;
  node [shape=box, fontname="Helvetica", fontsize=10, color="#333333"];
  edge [fontname="Helvetica", fontsize=10];

  N1 [label="1: setA = toWordSet(descA)\nsetB = toWordSet(descB)"];
  N2 [shape=diamond, label="2: setA.size===0 &&\nsetB.size===0"];
  N3 [label="3: return round(25 * 0) = 0"];
  N4 [label="4: intersectionSize = 0"];
  N5 [shape=diamond, label="5: has next word\nin setA? (loop test)"];
  N6 [shape=diamond, label="6: setB.has(word)"];
  N7 [label="7: intersectionSize += 1"];
  N8 [label="8: unionSize = setA.size +\nsetB.size - intersectionSize"];
  N9 [shape=diamond, label="9: unionSize === 0"];
  N10 [label="10: similarity = 0"];
  N11 [label="11: similarity =\nintersectionSize / unionSize"];
  N12 [label="12: return round(25 * similarity)"];

  N1 -> N2;
  N2 -> N3 [label="T"];
  N2 -> N4 [label="F"];
  N4 -> N5;
  N5 -> N6 [label="T"];
  N6 -> N7 [label="T"];
  N6 -> N5 [label="F"];
  N7 -> N5;
  N5 -> N8 [label="F"];
  N8 -> N9;
  N9 -> N10 [label="T (infeasible)"];
  N9 -> N11 [label="F"];
  N10 -> N12;
  N11 -> N12;
}
