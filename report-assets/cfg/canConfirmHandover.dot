digraph canConfirmHandover {
  rankdir=TB;
  node [shape=box, fontname="Helvetica", fontsize=10, color="#333333"];
  edge [fontname="Helvetica", fontsize=10];

  N1 [shape=diamond, label="1: status !== APPROVED"];
  N2 [label="2: throw \"must be APPROVED first\""];
  N3 [shape=diamond, label="3: !verifiedIdentity"];
  N4 [label="4: throw \"identity not verified\""];
  N5 [label="5: return true"];

  N1 -> N2 [label="T"];
  N1 -> N3 [label="F"];
  N3 -> N4 [label="T"];
  N3 -> N5 [label="F"];
}
