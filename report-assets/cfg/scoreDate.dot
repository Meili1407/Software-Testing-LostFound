digraph scoreDate {
  rankdir=TB;
  node [shape=box, fontname="Helvetica", fontsize=10, color="#333333"];
  edge [fontname="Helvetica", fontsize=10];

  N1 [label="1: diff = daysBetween(dateA, dateB)"];
  N2 [shape=diamond, label="2: diff === 0"];
  N3 [label="3: return 10"];
  N4 [shape=diamond, label="4: diff <= 3"];
  N5 [label="5: return round(10 * 0.5) = 5"];
  N6 [label="6: return 0"];

  N1 -> N2;
  N2 -> N3 [label="T"];
  N2 -> N4 [label="F"];
  N4 -> N5 [label="T"];
  N4 -> N6 [label="F"];
}
