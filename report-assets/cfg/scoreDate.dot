digraph scoreDate {
  rankdir=TB;
  node [shape=box, style="rounded,filled", fillcolor="#f5f6f8", fontname="Helvetica", fontsize=11, margin="0.15,0.1"];
  edge [fontname="Helvetica", fontsize=10];

  N1 [label="1: diff = daysBetween(dateA, dateB)"];
  N2 [label="2: diff === 0"];
  N3 [label="3: return WEIGHTS.date (10)"];
  N4 [label="4: diff <= 3"];
  N5 [label="5: return round(10 * 0.5) = 5"];
  N6 [label="6: return 0"];

  N1 -> N2;
  N2 -> N3 [label="True"];
  N2 -> N4 [label="False"];
  N4 -> N5 [label="True"];
  N4 -> N6 [label="False"];
}
