digraph validateItemForMatching {
  rankdir=TB;
  node [shape=box, style="", fontname="Helvetica", fontsize=10, color="#333333"];
  edge [fontname="Helvetica", fontsize=10];

  N1 [label="1: errors = []"];
  N2 [shape=diamond, label="2: !item ||\ntypeof item !== 'object'"];
  N3 [label="3: throw \"missing item\""];
  N4 [shape=diamond, label="4: has next field in\nREQUIRED_FIELDS?"];
  N5 [label="5: value = item[field]"];
  N6 [shape=diamond, label="6: value === undefined\n|| null || ''"];
  N7 [label="7: errors.push(...)"];
  N8 [shape=diamond, label="8: occurredAt !== undefined\n&& !== null"];
  N9 [label="9: date = new Date(occurredAt)"];
  N10 [shape=diamond, label="10: isNaN(date.getTime())"];
  N11 [label="11: errors.push(...)"];
  N12 [shape=diamond, label="12: errors.length > 0"];
  N13 [label="13: throw \"invalid item\""];
  N14 [label="14: return (valid)"];

  N1 -> N2;
  N2 -> N3 [label="T"];
  N2 -> N4 [label="F"];
  N4 -> N5 [label="T"];
  N5 -> N6;
  N6 -> N7 [label="T"];
  N6 -> N4 [label="F"];
  N7 -> N4;
  N4 -> N8 [label="F"];
  N8 -> N9 [label="T"];
  N9 -> N10;
  N10 -> N11 [label="T"];
  N10 -> N12 [label="F"];
  N11 -> N12;
  N8 -> N12 [label="F"];
  N12 -> N13 [label="T"];
  N12 -> N14 [label="F"];
}
