digraph validateItemForMatching {
  rankdir=TB;
  node [shape=box, style="rounded,filled", fillcolor="#f5f6f8", fontname="Helvetica", fontsize=11, margin="0.15,0.1"];
  edge [fontname="Helvetica", fontsize=10];

  N1 [label="1: errors = []"];
  N2 [label="2: !item || typeof item !== 'object'"];
  N3 [label="3: throw ValidationError\n(missing item)"];
  N4 [label="4: for field of REQUIRED_FIELDS\n(more fields?)"];
  N5 [label="5: value = item[field]"];
  N6 [label="6: value is undefined/null/''"];
  N7 [label="7: errors.push(missing field)"];
  N8 [label="8: occurredAt !== undefined && !== null"];
  N9 [label="9: date = new Date(occurredAt)"];
  N10 [label="10: isNaN(date.getTime())"];
  N11 [label="11: errors.push(invalid date)"];
  N12 [label="12: errors.length > 0"];
  N13 [label="13: throw ValidationError\n(invalid item)"];
  N14 [label="14: return (valid)"];

  N1 -> N2;
  N2 -> N3 [label="True"];
  N2 -> N4 [label="False"];
  N4 -> N5 [label="True (has next field)"];
  N5 -> N6;
  N6 -> N7 [label="True"];
  N6 -> N4 [label="False"];
  N7 -> N4;
  N4 -> N8 [label="False (no more fields)"];
  N8 -> N9 [label="True"];
  N8 -> N12 [label="False"];
  N9 -> N10;
  N10 -> N11 [label="True"];
  N10 -> N12 [label="False"];
  N11 -> N12;
  N12 -> N13 [label="True"];
  N12 -> N14 [label="False"];
}
