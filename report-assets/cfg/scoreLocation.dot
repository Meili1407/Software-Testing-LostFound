digraph scoreLocation {
  rankdir=TB;
  node [shape=box, fontname="Helvetica", fontsize=10, color="#333333"];
  edge [fontname="Helvetica", fontsize=10];

  N1 [label="1: a = normalizeText(locationA)\nb = normalizeText(locationB)"];
  N2 [shape=diamond, label="2: !a || !b"];
  N3 [label="3: return 0"];
  N4 [shape=diamond, label="4: a === b"];
  N5 [label="5: return 10"];
  N6 [shape=diamond, label="6: a.includes(b) ||\nb.includes(a)"];
  N7 [label="7: return round(10 * 0.5) = 5"];
  N8 [label="8: return 0"];

  N1 -> N2;
  N2 -> N3 [label="T"];
  N2 -> N4 [label="F"];
  N4 -> N5 [label="T"];
  N4 -> N6 [label="F"];
  N6 -> N7 [label="T"];
  N6 -> N8 [label="F"];
}
