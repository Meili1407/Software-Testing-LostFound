digraph decideClaim {
  rankdir=TB;
  node [shape=box, style="rounded,filled", fillcolor="#f5f6f8", fontname="Helvetica", fontsize=11, margin="0.15,0.1"];
  edge [fontname="Helvetica", fontsize=10];

  N1 [label="1: !VALID_ACTIONS.includes(action)"];
  N2 [label="2: throw ValidationError\n(invalid action)"];
  N3 [label="3: !VALID_MATCH_RESULTS.includes(matchResult)"];
  N4 [label="4: throw ValidationError\n(invalid matchResult)"];
  N5 [label="5: action === REJECT"];
  N6 [label="6: return {status: REJECTED}"];
  N7 [label="7: action === REQUEST_INFO"];
  N8 [label="8: return {status: INFO_REQUESTED}"];
  N9 [label="9: !hasEvidence"];
  N10 [label="10: throw ValidationError\n(evidence required)"];
  N11 [label="11: matchResult === WEAK_MATCH\n&& !staffVerifiedEvidence"];
  N12 [label="12: throw ValidationError\n(verification required)"];
  N13 [label="13: return {status: APPROVED}"];

  N1 -> N2 [label="True"];
  N1 -> N3 [label="False"];
  N3 -> N4 [label="True"];
  N3 -> N5 [label="False"];
  N5 -> N6 [label="True"];
  N5 -> N7 [label="False"];
  N7 -> N8 [label="True"];
  N7 -> N9 [label="False"];
  N9 -> N10 [label="True"];
  N9 -> N11 [label="False"];
  N11 -> N12 [label="True"];
  N11 -> N13 [label="False"];
}
