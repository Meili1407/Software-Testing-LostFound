digraph decideClaim {
  rankdir=TB;
  node [shape=box, fontname="Helvetica", fontsize=10, color="#333333"];
  edge [fontname="Helvetica", fontsize=10];

  N1 [shape=diamond, label="1: !VALID_ACTIONS\n.includes(action)"];
  N2 [label="2: throw \"invalid action\""];
  N3 [shape=diamond, label="3: !VALID_MATCH_RESULTS\n.includes(matchResult)"];
  N4 [label="4: throw \"invalid matchResult\""];
  N5 [shape=diamond, label="5: action === REJECT"];
  N6 [label="6: return REJECTED"];
  N7 [shape=diamond, label="7: action === REQUEST_INFO"];
  N8 [label="8: return INFO_REQUESTED"];
  N9 [shape=diamond, label="9: !hasEvidence"];
  N10 [label="10: throw \"evidence required\""];
  N11 [shape=diamond, label="11: matchResult===WEAK &&\n!staffVerifiedEvidence"];
  N12 [label="12: throw \"verification required\""];
  N13 [label="13: return APPROVED"];

  N1 -> N2 [label="T"];
  N1 -> N3 [label="F"];
  N3 -> N4 [label="T"];
  N3 -> N5 [label="F"];
  N5 -> N6 [label="T"];
  N5 -> N7 [label="F"];
  N7 -> N8 [label="T"];
  N7 -> N9 [label="F"];
  N9 -> N10 [label="T"];
  N9 -> N11 [label="F"];
  N11 -> N12 [label="T"];
  N11 -> N13 [label="F"];
}
