digraph scoreExactOptionalField {
  rankdir=TB;
  node [shape=box, fontname="Helvetica", fontsize=10, color="#333333"];
  edge [fontname="Helvetica", fontsize=10];

  N1 [label="1: a = normalizeText(valueA)\nb = normalizeText(valueB)"];
  N2 [shape=diamond, label="2: !a || !b"];
  N3 [label="3: return 0"];
  N4 [shape=diamond, label="4: a === b"];
  N5 [label="5: return weight"];
  N6 [label="6: return 0"];

  N1 -> N2;
  N2 -> N3 [label="T"];
  N2 -> N4 [label="F"];
  N4 -> N5 [label="T"];
  N4 -> N6 [label="F"];
}
