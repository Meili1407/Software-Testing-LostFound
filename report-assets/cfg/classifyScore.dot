digraph classifyScore {
  rankdir=TB;
  node [shape=box, fontname="Helvetica", fontsize=10, color="#333333"];
  edge [fontname="Helvetica", fontsize=10];

  N1 [shape=diamond, label="1: score >= 75"];
  N2 [label="2: return STRONG_MATCH"];
  N3 [shape=diamond, label="3: score >= 50"];
  N4 [label="4: return POSSIBLE_MATCH"];
  N5 [label="5: return WEAK_MATCH"];

  N1 -> N2 [label="T"];
  N1 -> N3 [label="F"];
  N3 -> N4 [label="T"];
  N3 -> N5 [label="F"];
}
