digraph classifyScore {
  rankdir=TB;
  node [shape=box, style="rounded,filled", fillcolor="#f5f6f8", fontname="Helvetica", fontsize=11, margin="0.15,0.1"];
  edge [fontname="Helvetica", fontsize=10];

  N1 [label="1: score >= 75"];
  N2 [label="2: return STRONG_MATCH"];
  N3 [label="3: score >= 50"];
  N4 [label="4: return POSSIBLE_MATCH"];
  N5 [label="5: return WEAK_MATCH"];

  N1 -> N2 [label="True"];
  N1 -> N3 [label="False"];
  N3 -> N4 [label="True"];
  N3 -> N5 [label="False"];
}
